{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anyserve-cloudflare-native",
  "main": "src/native-worker.ts",
  "compatibility_date": "2025-11-17",
  "build": {
    "command": "if [ -f console/package.json ]; then npm --prefix console run build; else npm --prefix ../../console run build; fi"
  },
  "assets": {
    "directory": "../../console/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/rpc/*", "/ws/*", "/healthz", "/readyz", "/metrics"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ANYSERVE_DO",
        "class_name": "AnyserveNativeDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "native-v1",
      "new_sqlite_classes": ["AnyserveNativeDO"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANYSERVE_R2",
      "bucket_name": "anyserve-journal"
    }
  ]
}
