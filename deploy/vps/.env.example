# DNS name with A/AAAA records pointing to this VPS.
# Caddy automatically provisions and renews Let's Encrypt TLS certificates.
ANYSERVE_DOMAIN=relay.example.com

# Endpoint advertised in /api/overview and the Console's "Connect worker" dialog.
# Use https:// for native HTTP/2 gRPC or wss:// for WebSocket fallback.
ANYSERVE_PUBLIC_ENDPOINT=https://relay.example.com

# Comma-separated bearer tokens. Generate distinct secrets with:
#   openssl rand -hex 24
# Client tokens authorize clients and the Browser Console (operator role).
ANYSERVE_CLIENT_TOKENS=replace-with-client-token
# Worker tokens authorize outbound workers only.
ANYSERVE_WORKER_TOKENS=replace-with-worker-token

# Total RAM budget in MiB for scaling pending/result/event byte limits (default 1024).
# ANYSERVE_MEMORY_LIMIT_MB=1024

# ── Optional GitHub Login Token Portal (--profile auth-github) ───────────────
# Set ANYSERVE_CADDYFILE=./Caddyfile.auth-github and uncomment below, then start:
#   docker compose --profile auth-github up -d
# ANYSERVE_CADDYFILE=./Caddyfile.auth-github
# ANYSERVE_CONSOLE_AUTH_PORTAL_URL=https://relay.example.com/tokens
# ANYSERVE_TOKEN_SIGNING_KEY=replace-with-32byte-hex-secret
# ANYSERVE_AUTH_REVOCATION_URL=http://auth-github:3002/internal/revocations
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# ANYSERVE_AUTH_MIN_ACCOUNT_AGE_DAYS=30
# ANYSERVE_AUTH_ALLOWED_USERS=
# ANYSERVE_AUTH_MAX_TOKENS_PER_USER=20
