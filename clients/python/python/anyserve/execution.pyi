from dataclasses import dataclass
from typing import Any, Iterator

@dataclass(frozen=True)
class ExecutionOptions:
    required_attributes: dict[str, str] = ...
    preferred_attributes: dict[str, str] = ...
    required_capacity: dict[str, int] = ...
    metadata: dict[str, str] = ...
    params: bytes = ...
    priority: int = ...
    queue_timeout_ms: int = ...
    execution_timeout_ms: int = ...
    total_timeout_ms: int = ...
    spillover_after_ms: int = ...
    max_attempts: int = ...

class ExecutionEvents(Iterator[dict[str, Any]]):
    def __iter__(self) -> ExecutionEvents: ...
    def __next__(self) -> dict[str, Any]: ...
    def close(self) -> None: ...
    def __enter__(self) -> ExecutionEvents: ...
    def __exit__(self, *args: Any) -> None: ...
class StreamingInvocation(ExecutionEvents):
    def send(self, data: bytes, metadata: dict[str, str] | None = ...) -> None: ...
    def finish_input(self) -> None: ...
class ExecutionClient:
    def __init__(self, endpoint: str, *, token: str | None = ...) -> None: ...
    def submit(self, interface: str, inputs: bytes | list[dict[str, Any]] = ..., *, job_id: str | None = ...,
               durability: str = ..., options: ExecutionOptions | None = ...) -> dict[str, Any]: ...
    def invoke(self, interface: str, inputs: bytes | list[dict[str, Any]] = ..., *,
               options: ExecutionOptions | None = ...) -> ExecutionEvents: ...
    def invoke_stream(self, interface: str, *, options: ExecutionOptions | None = ...) -> StreamingInvocation: ...
    def execute(self, interface: str, inputs: bytes | list[dict[str, Any]] = ..., *,
                options: ExecutionOptions | None = ...) -> list[dict[str, Any]]: ...
    def get(self, job_id: str, *, include_outputs: bool = ...) -> dict[str, Any]: ...
    def cancel(self, job_id: str, reason: str = ...) -> dict[str, Any]: ...
    def watch(self, job_id: str, *, after_sequence: int = ...) -> ExecutionEvents: ...
    def result(self, job_id: str) -> list[dict[str, Any]]: ...
