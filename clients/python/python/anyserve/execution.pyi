from dataclasses import dataclass
from typing import Any, AsyncIterator, Iterator

@dataclass(frozen=True)
class ExecutionOptions:
    required_attributes: dict[str, str] = ...
    preferred_attributes: dict[str, str] = ...
    required_capacity: dict[str, int] = ...
    metadata: dict[str, str] = ...
    params: bytes = ...
    priority: int = ...
    queue_timeout_ms: int = ...
    execution_timeout_ms: int = ...
    total_timeout_ms: int = ...
    spillover_after_ms: int = ...
    max_attempts: int = ...
    affinity_key: str = ...
    fairness_key: str = ...
    concurrency_key: str = ...

class ExecutionEvents(Iterator[dict[str, Any]]):
    def __iter__(self) -> ExecutionEvents: ...
    def __next__(self) -> dict[str, Any]: ...
    def close(self) -> None: ...
    def __enter__(self) -> ExecutionEvents: ...
    def __exit__(self, *args: Any) -> None: ...
class StreamingInvocation(ExecutionEvents):
    def send(self, data: bytes, metadata: dict[str, str] | None = ...) -> None: ...
    def finish_input(self) -> None: ...
DEFAULT_ENDPOINT: str

def resolve_endpoint(endpoint: str | None) -> str: ...

class ExecutionClient:
    def __init__(self, endpoint: str | None = ..., *, token: str | None = ..., namespace: str | None = ...) -> None: ...
    def submit(
        self,
        interface: str,
        inputs: bytes | list[dict[str, Any]] = ...,
        *,
        job_id: str | None = ...,
        durability: str = ...,
        options: ExecutionOptions | None = ...,
        conflict_policy: str | None = ...,
    ) -> dict[str, Any]: ...
    def invoke(self, interface: str, inputs: bytes | list[dict[str, Any]] = ..., *,
               options: ExecutionOptions | None = ...) -> ExecutionEvents: ...
    def invoke_stream(self, interface: str, *, options: ExecutionOptions | None = ...) -> StreamingInvocation: ...
    def execute(self, interface: str, inputs: bytes | list[dict[str, Any]] = ..., *,
                options: ExecutionOptions | None = ...) -> list[dict[str, Any]]: ...
    def call(self, interface: str, payload: bytes = ..., *, options: ExecutionOptions | None = ...) -> bytes: ...
    def list(
        self,
        *,
        states: list[str] | None = ...,
        limit: int = ...,
        page_token: str = ...,
    ) -> dict[str, Any]: ...
    def get(self, job_id: str, *, include_outputs: bool = ...) -> dict[str, Any]: ...
    def cancel(self, job_id: str, reason: str = ...) -> dict[str, Any]: ...
    def watch(self, job_id: str, *, after_sequence: int = ...) -> ExecutionEvents: ...
    def result(self, job_id: str) -> list[dict[str, Any]]: ...

class AsyncExecutionEvents(AsyncIterator[dict[str, Any]]):
    def __aiter__(self) -> AsyncExecutionEvents: ...
    async def __anext__(self) -> dict[str, Any]: ...
    def close(self) -> None: ...
    async def aclose(self) -> None: ...
    async def __aenter__(self) -> AsyncExecutionEvents: ...
    async def __aexit__(self, *args: Any) -> None: ...

class AsyncStreamingInvocation(AsyncExecutionEvents):
    async def send(self, data: bytes, metadata: dict[str, str] | None = ...) -> None: ...
    async def finish_input(self) -> None: ...
    async def aclose(self) -> None: ...

class AsyncExecutionClient:
    def __init__(self, endpoint: str | None = ..., *, token: str | None = ..., namespace: str | None = ...) -> None: ...
    async def submit(
        self,
        interface: str,
        inputs: bytes | list[dict[str, Any]] = ...,
        *,
        job_id: str | None = ...,
        durability: str = ...,
        options: ExecutionOptions | None = ...,
        conflict_policy: str | None = ...,
    ) -> dict[str, Any]: ...
    async def invoke(self, interface: str, inputs: bytes | list[dict[str, Any]] = ..., *,
                     options: ExecutionOptions | None = ...) -> AsyncExecutionEvents: ...
    async def invoke_stream(self, interface: str, *, options: ExecutionOptions | None = ...) -> AsyncStreamingInvocation: ...
    async def execute(self, interface: str, inputs: bytes | list[dict[str, Any]] = ..., *,
                      options: ExecutionOptions | None = ...) -> list[dict[str, Any]]: ...
    async def call(self, interface: str, payload: bytes = ..., *, options: ExecutionOptions | None = ...) -> bytes: ...
    async def list(
        self,
        *,
        states: list[str] | None = ...,
        limit: int = ...,
        page_token: str = ...,
    ) -> dict[str, Any]: ...
    async def get(self, job_id: str, *, include_outputs: bool = ...) -> dict[str, Any]: ...
    async def cancel(self, job_id: str, reason: str = ...) -> dict[str, Any]: ...
    async def watch(self, job_id: str, *, after_sequence: int = ...) -> AsyncExecutionEvents: ...
    async def result(self, job_id: str) -> list[dict[str, Any]]: ...
